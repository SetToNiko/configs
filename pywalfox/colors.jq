
# Which palette colour goes into which pywal slot (Pywalfox reads these)
.[$n] | {
  wallpaper: "", alpha: "100",
  special: { background: .bg, foreground: .fg, cursor: .fg },
  colors: {
    color0: .bg,    color1: .red,     color2: .green,   color3: .yellow,
    color4: .blue,  color5: .magenta, color6: .cyan,    color7: .fg_dim,
    color8: .bg2,   color9: .red_lit, color10: .yellow,  color11: .yellow,
    color12: .blue, color13: .magenta, color14: .cyan,  color15: .fg
  }
}
