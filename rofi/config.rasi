@theme "default"
@import "~/.config/colors/rofi.rasi"

* {
    background: var(bg0);
    foreground: var(fg0);
    lightbg: var(bg0);
    lightfg: var(bg3);
    selected-normal-background: var(yellow);
    selected-normal-foreground: var(bg0);
    border-color: var(yellow);
    separatorcolor: var(grey2);
}

