{
  "version": 1,
  "layout": {
    "tabs": "bottom",
    "inner-tabs": "top",
    "sizes": {
      "fonts-width": 0.28,
      "colours-width": 0.32,
      "sample-height": 0.3,
      "picker-height": 0.0,
      "preview-split": 0.5,
      "narrow-preview-height": 0.42,
      "narrow-fonts-width": 0.45
    }
  },
  "colours": {
    "open-groups": [
      "Base"
    ],
    "picker-at-start": "hidden",
    "picker-after-editing": "hide-on-esc",
    "derived-highlight": {
      "highlight": true,
      "highlight-colour": "bg_visual_blue",
      "underline": "off",
      "underline-colour": "yellow",
      "text": false,
      "text-colour": "yellow",
      "text-weight": "normal"
    }
  },
  "fonts": {
    "sample-at-start": "shown",
    "list-opens-to-current-font": true,
    "installed-list": "~/dotfiles-nixos/home/fonts-installed.json",
    "mono-filter": "mono",
    "ui-filter": "propo",
    "bar-filter": "nerd-font"
  },
  "font-list": {
    "hide-bitmap": true,
    "hide-cjk-emoji-math": true,
    "spacing": "any",
    "nerd-font": "any"
  },
  "hover": {
    "highlight": false,
    "highlight-colour": "bg3",
    "underline": "single",
    "underline-colour": "grey1",
    "text": true,
    "text-colour": "yellow",
    "text-weight": "normal",
    "pane-border": "yellow",
    "preview-border": "purple"
  }
}
