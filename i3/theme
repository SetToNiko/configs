# Columns: border, background, text, indicator, child_border
  client.focused          $yellow $yellow $bg0     $blue   $yellow
  client.focused_inactive $bg3    $bg3    $fg0     $bg3    $bg3
  client.unfocused        $bg0     $bg0     $grey2 $bg0     $bg0
  client.urgent           $red    $red    $fg0     $red    $red
  client.background       $bg0

bar {
        status_command i3blocks
        # no system tray: the i3blocks bluetooth block replaces the blueman icon
        tray_output none

        colors {
          background $bg0
                  statusline $fg0
                  separator  $bg3

                  #                  border  background text
                  focused_workspace  $yellow $yellow    $bg0
                  active_workspace   $bg3    $bg3       $fg0
                  inactive_workspace $bg0     $bg0        $grey2
                  urgent_workspace   $red    $red       $fg0
                  binding_mode       $blue   $blue      $fg0
                  }

}
