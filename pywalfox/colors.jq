
# Which palette colour goes into which pywal slot (Pywalfox reads these)
.[$n] | {
  wallpaper: "", alpha: "100",
  special: { background: .bg0, foreground: .fg0, cursor: .fg0 },
  colors: {
    color0: .bg0,    color1: .red,     color2: .green,   color3: .yellow,
    color4: .blue,  color5: .purple, color6: .aqua,    color7: .grey2,
    color8: .bg3,   color9: .orange, color10: .yellow,  color11: .yellow,
    color12: .blue, color13: .purple, color14: .aqua,  color15: .fg0
  }
}
