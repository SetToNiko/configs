{
  "version": 1,
  "layout": {
    "tabs": "bottom",
    "sizes": {
      "fonts-width": 0.28,
      "colours-width": 0.32,
      "sample-height": 0.3,
      "picker-height": 0.0,
      "preview-split": 0.5,
      "narrow-preview-height": 0.42,
      "narrow-fonts-width": 0.45
    }
  },
  "colours": {
    "open-groups": [
      "Base"
    ],
    "picker-at-start": "hidden",
    "picker-after-editing": "hide-on-esc"
  },
  "fonts": {
    "sample-at-start": "shown",
    "list-opens-to-current-font": true
  },
  "font-list": {
    "hide-bitmap": true,
    "hide-cjk-emoji-math": true,
    "spacing": "any",
    "nerd-font": "any"
  }
}
